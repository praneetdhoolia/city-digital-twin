{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config user.name 'praneetdhoolia' && git config user.email '65392157+praneetdhoolia@users.noreply.github.com' && git config commit.gpgsign false",
            "statusMessage": "Setting git identity to praneetdhoolia"
          },
          {
            "type": "command",
            "command": "git config core.hooksPath \"${CLAUDE_PROJECT_DIR}/.githooks\"",
            "statusMessage": "Activating tracked git hooks (.githooks)"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/branch-naming-reminder.sh\"",
            "statusMessage": "Checking branch-naming convention"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/src/run/session_gate.py\" --digest",
            "statusMessage": "Printing the goal, the scoreboard and the state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__create_pull_request|mcp__github__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-session-ref-in-pr.sh\"",
            "statusMessage": "Checking PR for forbidden session reference"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-pr-on-docs.sh\"",
            "statusMessage": "A PR cannot open on stale documents"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-session-ref-in-gh-pr.sh\"",
            "statusMessage": "Checking gh pr command for forbidden session reference"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-pr-on-docs.sh\"",
            "statusMessage": "A PR cannot open on stale documents"
          }
        ]
      }
    ]
  },
