{
  "schema_version": 1,
  "id": "newcastle",
  "name": "Newcastle (NSW) region",
  "description": "Five local government areas, 4,086 km2, 1,500 core SA1s. Wickham is ONE SUBURB of it, and the name is legitimate only for that suburb's own zones and stops, for Newcastle Interchange at Wickham, and for scenario S1 which starts there.",

  "jurisdiction": {
    "country": "Australia",
    "subdivision": "New South Wales",
    "statistical_agency": "Australian Bureau of Statistics (ABS)",
    "transport_agency": "Transport for NSW (TfNSW)"
  },

  "crs": {
    "epsg": 28356,
    "datum": "GDA94",
    "zone": "MGA Zone 56",
    "units": "m",
    "coord_suffix": "mga56"
  },
  "base_year": 2026,
  "currency": "AUD",
  "seed": 20260810,

  "boundary": {
    "dataset": "ABS ASGS Edition 3 (2021) digital boundaries",
    "level": "LGA",
    "selector": ["Newcastle", "Lake Macquarie", "Maitland", "Cessnock", "Port Stephens"],
    "external_tier": {
      "level": "SA2",
      "selector": ["Singleton", "Muswellbrook", "Upper Hunter", "Dungog"],
      "reason": "The remainder of SA4 'Hunter Valley exc Newcastle', retained only as a boundary treatment for Hunter Line through-demand. It is not modelled at SA1 and carries no intra-zonal detail."
    }
  },

  "zone_system": {
    "residence": "SA1",
    "external": "SA2",
    "workplace": "DZN",
    "id_column": "SA1_CODE21"
  },

  "modes": ["car", "ride", "pt", "bike", "walk", "taxi"],
  "day_types": ["WEEKDAY", "SAT", "SUN"],

  "mode_share_target": {
    "source": "NSW Household Travel Survey",
    "geography": "Newcastle LGA, both trip ends",
    "filter_value": "Newcastle",
    "column": "target_lga_pct",
    "note": "The LGA series, NOT the all-residents series. The package holds both, they are computed over different populations, and reading the wrong one has inverted a headline. src/calibrate/fit.py reads this key from the metrics document."
  },

  "intervention": {
    "name": "Newcastle Light Rail",
    "opened": "2019-02",
    "base_scenario": "S2",
    "mode": "tram",
    "scenarios": ["S0", "S1", "S2", "S2a", "S2b", "S2c", "S3", "S4", "S5", "S6"]
  },

  "adapters": {
    "osm": {
      "script": "extract/overpass.py",
      "produces": ["networks/osm"],
      "description": "Overpass harvest over a tiled extent DERIVED from the resolved LGA boundary. Never a typed rectangle."
    },
    "gtfs": {
      "script": "extract/fetch_gtfs.py",
      "produces": ["schedules/raw"],
      "description": "Era-variant GTFS bundles from the TfNSW historical GTFS S3 archive."
    },
    "open_data": {
      "script": "extract/fetch_open_data.py",
      "produces": ["data/raw/opal", "data/raw/counts", "data/raw/hts", "data/raw/jtw"],
      "description": "Opal patronage, road traffic counts, the Household Travel Survey and the 2011 journey-to-work origin-destination flow from the TfNSW Open Data Hub."
    },
    "statistical": {
      "script": "extract/fetch_abs_dem.py",
      "produces": ["data/raw/boundaries", "data/raw/census", "data/raw/dem"],
      "description": "ABS ASGS boundaries and 2021 Census DataPacks, plus Copernicus GLO-30 DEM tiles."
    },
    "speed_zones": {
      "script": "extract/extract_speed_zones.py",
      "produces": ["data/processed/network/A1_speed_zones.gpkg"],
      "description": "TfNSW regulated speed zones - the legal instrument rather than a mapper's transcription of a sign."
    },
    "zones": {
      "script": "extract/extract_zones.py",
      "produces": ["data/processed/zones"]
    },
    "census": {
      "script": "extract/extract_census.py",
      "produces": ["data/processed/census"]
    },
    "hts": {
      "script": "extract/extract_hts.py",
      "produces": ["data/processed/hts"]
    },
    "observed": {
      "script": "extract/slice_newcastle.py",
      "produces": ["data/processed/observed"],
      "description": "Slices the national and statewide open datasets down to the study area."
    },
    "freight_profile": {
      "script": "extract/extract_freight_profile.py",
      "produces": ["data/processed/observed/freight_hourly_profile.csv",
                   "data/processed/observed/freight_day_factors.csv"],
      "description": "Heavy-vehicle hourly departure profile and weekend day factors, MEASURED from the classified RMS permanent hourly counts at study-area stations (DECISIONS.md 9.49)."
    }
  },

  "lineage": {
    "data/processed/corridor": "build/build_corridor_layers.py",
    "data/processed/landuse": "build/build_landuse_parking.py + src/build/build_zone_attractions.py",
    "data/processed/validation": "build/build_validation_targets.py",
    "data/processed/observed/external_interaction.json": "build/build_external_interaction.py",
    "schedules": "build/build_era_feeds.py",
    "schedules/scenarios": "build/build_scenario_schedules.py",
    "scenarios": "build/build_scenario_configs.py",
    "params/C3_count_comparison.json": "build/build_validation_targets.py",
    "data/processed/network/A1_corridor_road_edges.csv": "build/build_corridor_road_attributes.py",
    "data/processed/network/A1_road_variant_patches.csv": "build/build_corridor_road_attributes.py",
    "data/processed/network/A2_turn_restrictions_resolved.csv": "build/build_corridor_road_attributes.py",
    "data/processed/network/_corridor_attributes_report.json": "build/build_corridor_road_attributes.py",
    "data/processed/observed/licence_rate_by_age_band.json": "build/build_licence_rates.py",
    "data/processed/observed/licence_rates_by_age_lga.csv": "build/build_licence_rates.py",
    "data/processed/observed/light_day_factors.csv": "extract/extract_daytype_factors.py",
    "data/processed/observed/light_hourly_profile.csv": "extract/extract_daytype_factors.py",
    "data/processed/validation/_mode_targets_report.json": "build/build_mode_targets.py",
    "data/processed/validation/mode_targets_by_mode.csv": "build/build_mode_targets.py",
    "data/processed/validation/pt_boardings_targets.json": "build/build_mode_targets.py",
    "data/processed/zones/sa1_to_lga.csv": "build/map_sa1_to_lga.py",
    "networks/matsim/crossings": "build/build_level_crossings.py",
    "networks/matsim/signals": "build/build_matsim_signals.py",
    "networks/matsim/schedules/_dwell_report.json": "build/build_charging_dwell_offsets.py",
    "networks/matsim/schedules/S2/transitSchedule_dwell.xml.gz": "build/build_charging_dwell_offsets.py",
    "networks/matsim/schedules/S2a/transitSchedule_dwell.xml.gz": "build/build_charging_dwell_offsets.py",
    "networks/matsim/schedules/S2b/transitSchedule_dwell.xml.gz": "build/build_charging_dwell_offsets.py",
    "networks/matsim/schedules/S2c/transitSchedule_dwell.xml.gz": "build/build_charging_dwell_offsets.py",
    "networks/matsim/schedules/S4/transitSchedule_dwell.xml.gz": "build/build_charging_dwell_offsets.py",
    "networks/matsim/schedules/S5/transitSchedule_dwell.xml.gz": "build/build_charging_dwell_offsets.py"
  },

  "sources": [
    {
      "name": "TfNSW Open Data Hub - GTFS, Opal, traffic counts, Household Travel Survey, speed zones",
      "url": "https://opendata.transport.nsw.gov.au/",
      "licence": "CC-BY 4.0",
      "share_alike": false,
      "provides": ["schedules", "data/raw/opal", "data/raw/counts", "data/raw/hts", "data/raw/jtw", "data/raw/speedzones"]
    },
    {
      "name": "Australian Bureau of Statistics - Census DataPacks, ASGS boundaries",
      "url": "https://www.abs.gov.au/",
      "licence": "CC-BY 4.0",
      "share_alike": false,
      "provides": ["data/raw/census", "data/raw/boundaries"]
    },
    {
      "name": "OpenStreetMap, via Overpass",
      "url": "https://www.openstreetmap.org/",
      "licence": "ODbL 1.0",
      "share_alike": true,
      "provides": ["networks/osm"]
    },
    {
      "name": "Copernicus GLO-30 Digital Elevation Model",
      "url": "https://copernicus-dem-30m.s3.amazonaws.com/",
      "licence": "ESA, free and open",
      "share_alike": false,
      "provides": ["data/raw/dem"]
    }
  ],

  "package_licence": "CC-BY 4.0",
  "derived_licences": {
    "data/processed/network/*": "ODbL 1.0",
    "data/processed/corridor/*": "ODbL 1.0",
    "data/processed/landuse/*": "ODbL 1.0",
    "networks/matsim/*": "ODbL 1.0",
    "scenarios/matsim/*network*.xml.gz": "ODbL 1.0"
  },
  "derived_licences_basis": "The layers built from OpenStreetMap geometry carry its share-alike ODbL label (#117): the road, active, signal, parking and gradient network layers; the corridor layers (OSM signals and alignment); the land-use and parking layers (OSM parking, POI and buildings); the MATSim networks and the run networks patched from them. Population, plans, schedules, targets, observations and census-derived layers are CC-BY 4.0: the plans reference OSM way ids as link ids but carry no OSM geometry or tags. Declared here by glob because which of a city's layers embed OSM is a fact about that city's build; the framework names no artefact.",

  "unobtained": [
    {
      "input": "SCATS signal phasing",
      "reason": "Refused by TfNSW policy, documented and citable. The published Traffic Lights Location inventory gives identity, location and install date - no phase plan, cycle time or split.",
      "handled_by": "sweep",
      "field": "A.signals.scats_phasing"
    },
    {
      "input": "Journey-linked Opal",
      "reason": "Not published. Estimating the transfer penalty needs tap-on/tap-off TIMING; every Opal source held is a monthly aggregate and the stop-level tap data is holdout.",
      "handled_by": "sweep",
      "field": "B.opal.journey_linked"
    },
    {
      "input": "Measured light rail charging dwell",
      "reason": "Never measured in the field. Worth 11% of end-to-end corridor run time.",
      "handled_by": "sweep",
      "field": "A.lightrail.dwell_charging_s"
    },
    {
      "input": "Retail floorspace and vacancy audit",
      "reason": "No frontage-level audit is published for the corridor. Hypothesis B2 depends on it.",
      "handled_by": "sweep",
      "field": "D.retail.vacancy_rate"
    }
  ]
}
